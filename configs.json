{
  "data": {
    "train_path": "TinyStories/training_ids.bin",
    "validation_path": "TinyStories/validation_ids.bin",
    "dtype": "uint16"
  },

  "model": {
    "vocab_size": 10000,
    "context_length": 256,
    "d_model": 512,
    "num_layers": 4,
    "num_heads": 16,
    "d_ff": 1344,
    "theta": 10000.0
  },

  "optimizer": {
    "lr": 1e-3,
    "betas": [0.9, 0.95],
    "eps": 1e-6,
    "weight_decay": 0.01
  },

  "scheduler": {
    "warmup_iters": 100,
    "cosine_cycle_iters": 5000,
    "min_learning_rate": 1e-4,
    "max_learning_rate": 1e-3
  },

  "training": {
    "batch_size": 256,
    "max_iters": 5000,
    "gradient_clip_max_norm": 1.0,
    "device": "cpu"
  },

  "evaluation": {
    "interval": 200,
    "num_eval_batches": 20
  },

  "checkpoint": {
    "interval": 500,
    "output_dir": "checkpoints",
    "resume_from": null
  },

  "logging": {
  "interval": 10,
  "use_wandb": true,
  "wandb_mode": "online",
  "project": "cs336-transformer",
  "run_name": "baseline-small"
  }
}